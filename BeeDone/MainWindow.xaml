<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="BeeDone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Models="using:BeeDone.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BeeDone"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BeeDone"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Padding="16"
        ColumnSpacing="12"
        RowSpacing="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <!--  Bannière - titre  -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="16"
            Background="#FFE27A"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <!--
                    Image : Honeybee (3D), Fluent Emoji, Microsoft
                    https://github.com/microsoft/fluentui-emoji
                    Licence MIT, Copyright (c) Microsoft Corporation
                -->
                <Image
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Logo de BeeDone : une abeille en plein vol"
                    Source="ms-appx:///Assets/Images/honeybee_3d.png" />

                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="1"
                    FontSize="28"
                    FontStyle="Italic"
                    FontWeight="SemiBold"
                    Foreground="#1A1A1A"
                    Text="Bee Done" />
            </StackPanel>
        </Border>

        <!--  Zone d'ajout  -->
        <Grid
            x:Name="grdZoneAjout"
            Grid.Row="1"
            Grid.Column="0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Header="Nouvelle tâche"
                PlaceholderText="Ex. : Réviser WinUI"
                Text="{x:Bind ViewModel.NouvelleTache, Mode=TwoWay}" />

            <!--  Bouton d'ajout  -->
            <Button
                x:Name="btnAjoutTache"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Ajouter la tâche"
                Background="#FFC93C"
                Click="btnAjouterTache_Click"
                Foreground="#1A1A1A">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Ajouter" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Encadré de la liste  -->
        <Border
            x:Name="brdListeTaches"
            Grid.Row="2"
            Grid.Column="0"
            Padding="16"
            Background="#FFFBEA"
            BorderBrush="#FFC93C"
            BorderThickness="1.5"
            CornerRadius="8">
            <ListView
                AutomationProperties.Name="Liste des tâches"
                ItemsSource="{x:Bind ViewModel.Taches, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.TacheSelectionnee, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="Models:Tache">
                        <StackPanel Padding="0,12">
                            <TextBlock Text="{x:Bind Nom}" />
                            <TextBlock FontSize="12" Text="{x:Bind DateAjout}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!--  Encadré des détails  -->
        <Border
            x:Name="brdDetailsTache"
            Grid.Row="2"
            Grid.Column="1"
            Padding="16"
            VerticalAlignment="Top"
            Background="#FFFBEA"
            BorderBrush="#FFC93C"
            BorderThickness="1.5"
            CornerRadius="8">
            <StackPanel Spacing="12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="2"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Détails de la tâche" />

                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Fermer les détails"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="btnFermerDetails_Click">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </Grid>

                <TextBox Header="Nom" Text="Réparer la fuite d'eau" />

                <TextBox
                    Height="100"
                    AcceptsReturn="True"
                    Header="Description"
                    Text="Le robinet de la cuisine fuit beaucoup"
                    TextWrapping="Wrap" />

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Priorité" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Urgent" IsChecked="True" />
                        <CheckBox Content="Important" IsChecked="True" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Quadrant : Urgent et important" />

                <TextBlock FontSize="12" Text="Ajoutée le 01-10-2026 à 14 h 25" />


                <!--  Suppression d'une tâche  -->

                <!--<Button
                    Background="#FFD6D6"
                    Content="Supprimer la tâche sélectionnée"
                    Foreground="#8B1A1A" />-->
            </StackPanel>
        </Border>

        <!--  Suppression d'une tâche : déplacée pour la démo  -->
        <Button
            Grid.Row="3"
            Grid.Column="0"
            Background="#FFD6D6"
            Click="btnSupprimerTache_Click"
            Content="Supprimer la tâche sélectionnée"
            Foreground="#8B1A1A" />
    </Grid>

</Window>
